diff --git a/Tools/veir_lit.py b/Tools/veir_lit.py
new file mode 100644
index 000000000..d539cf6df
--- /dev/null
+++ b/Tools/veir_lit.py
@@ -0,0 +1,18 @@
+"""Reference checks must be observable when their required tool is unavailable."""
+from pathlib import Path
+import re
+
+import lit.formats
+import lit.Test
+
+
+class VeirShTest(lit.formats.ShTest):
+    def execute(self, test, lit_config):
+        if not test.config.veir_mlir_compatible:
+            # Skip the whole file explicitly rather than report a passing
+            # compatibility assertion which did not run.
+            source = Path(test.getSourcePath()).read_text()
+            if re.search(r"RUN:.*\bMLIR_(?:UNREGISTERED_)?(?:ROUNDTRIP|INVALID)\b", source):
+                return lit.Test.Result(lit.Test.UNSUPPORTED,
+                                       test.config.veir_mlir_unavailable_reason)
+        return super().execute(test, lit_config)

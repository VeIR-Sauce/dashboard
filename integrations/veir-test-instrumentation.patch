+/-- Lossless machine-readable results. Integer payloads use decimal strings so
+    consumers do not lose bits through a JSON number implementation. -/
+private def runtimeValueJson : RuntimeValue → Lean.Json
+  | .int width (.val value) => Lean.Json.mkObj
+      [("kind", "int"), ("width", toJson width), ("value", toJson (toString value.toNat))]
+  | .int width .poison => Lean.Json.mkObj
+      [("kind", "int"), ("width", toJson width), ("poison", toJson true)]
+  | .byte width value => Lean.Json.mkObj
+      [("kind", "byte"), ("width", toJson width), ("value", toJson (toString value.val.toNat)),
+       ("poison_mask", toJson (toString value.poison.toNat))]
+  | .float type value => Lean.Json.mkObj
+      [("kind", "float"), ("type", toJson (toString type)),
+       ("width", toJson type.format.bitwidth), ("bits", toJson (toString value.toBits.toNat))]
+  | .addr value => Lean.Json.mkObj
+      [("kind", "address"), ("width", toJson (64 : Nat)), ("value", toJson (toString value.toNat))]
+  | .reg value => Lean.Json.mkObj
+      [("kind", "register"), ("width", toJson (64 : Nat)), ("value", toJson (toString value.val.toNat))]
+  | .felt fieldType value => Lean.Json.mkObj
+      [("kind", "felt"), ("type", toJson (toString fieldType)), ("value", toJson (toString value))]
+
+private def resultJson (outcome : String) (results : Array RuntimeValue := #[]) : Lean.Json :=
+  Lean.Json.mkObj [("schema_version", toJson (1 : Nat)), ("outcome", toJson outcome),
+    ("results", Lean.Json.arr (results.map runtimeValueJson))]
 

diff --git a/Test/Interpreter/check-json.py b/Test/Interpreter/check-json.py
new file mode 100644
index 000000000..299f0e546
--- /dev/null
+++ b/Test/Interpreter/check-json.py
@@ -0,0 +1,11 @@
+"""Compare a complete JSON result, without depending on object key order."""
+import json
+from pathlib import Path
+import sys
+
+prefix = "// EXPECT-JSON: "
+lines = [line[len(prefix):] for line in Path(sys.argv[1]).read_text().splitlines() if line.startswith(prefix)]
+assert len(lines) == 1, "Exactly one complete expected JSON result is required"
+expected = json.loads(lines[0])
+actual = json.load(sys.stdin)
+assert actual == expected, f"Expected {expected!r}, got {actual!r}"
